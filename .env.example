# Copie para .env e ajuste. O arquivo .env nunca deve ir para o GitHub.
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux e Mac:          cp .env.example .env

# Segredo que assina e confere os tokens de login (mínimo de 32 caracteres).
# TODOS os serviços usam o MESMO valor. Este é só para aula: em produção, gere outro com
#   docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=segredo-so-para-aula-troque-em-producao-0123456789

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# 0 = desliga a documentação /docs (recomendado em produção)
DOCS=1